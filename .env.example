# LLM Configuration - OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
CRYPTOAGENTS_LLM_DEEP_THINK_MODEL=claude-opus
CRYPTOAGENTS_LLM_QUICK_THINK_MODEL=gpt-4o
CRYPTOAGENTS_LLM_BACKUP_MODEL=deepseek-chat
# Optional: switch the LLM provider from OpenRouter to a local Ollama server
CRYPTOAGENTS_LLM_PROVIDER=openrouter  # openrouter or ollama
CRYPTOAGENTS_OLLAMA_BASE_URL=http://localhost:11434/v1  # Only used when CRYPTOAGENTS_LLM_PROVIDER=ollama

# Data APIs
NANSEN_API_KEY=your_nansen_api_key_here
COINGECKO_API_KEY=your_coingecko_api_key_here  # Optional, free tier available
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here  # Optional backup

# Portfolio Configuration - Your Wallets
PORTFOLIO_WALLET_HYPERLIQUID=your_hyperliquid_wallet_address_here
PORTFOLIO_WALLET_SOLANA=your_solana_wallet_address_here
PORTFOLIO_WALLET_PRIVATE_KEY=your_wallet_private_key_here  # REQUIRED for trading - signs EIP-712 messages, never share or commit this
PORTFOLIO_STABLE_COIN_RESERVE=0.30  # Keep 30% in stablecoins
PORTFOLIO_MAX_ALLOCATION_PER_ASSET=0.15  # Max 15% per asset

# Trading Backend
TRADING_BACKEND=nansen  # nansen (Nansen-brokered execution) or hyperliquid_sdk (direct SDK execution)

# Framework Configuration
CRYPTOAGENTS_OUTPUT_LANGUAGE=en
CRYPTOAGENTS_MAX_DEBATE_ROUNDS=3
CRYPTOAGENTS_MAX_RISK_ROUNDS=2
CRYPTOAGENTS_CHECKPOINT_ENABLED=true
CRYPTOAGENTS_TEMPERATURE=0.7
CRYPTOAGENTS_LLM_MAX_RETRIES=3
CRYPTOAGENTS_MAX_TOKENS=8000

# Trading Configuration
CRYPTOAGENTS_TRADEABLE_CRYPTOS=BTC,ETH,SOL,ARB,OP
CRYPTOAGENTS_INITIAL_PORTFOLIO_VALUE=100000
CRYPTOAGENTS_MAX_POSITION_SIZE=0.1
CRYPTOAGENTS_RISK_PER_TRADE=0.02

# Directories
CRYPTOAGENTS_RESULTS_DIR=./results
CRYPTOAGENTS_CACHE_DIR=./cache
CRYPTOAGENTS_MEMORY_LOG_PATH=./cache/trading_memory.md

# Optional: Debug Mode
CRYPTOAGENTS_DEBUG=false

# Hyperliquid Perpetuals Configuration
HYPERLIQUID_TRADING_ENABLED=false  # Set to true to enable live trading
HYPERLIQUID_MAX_LEVERAGE=20  # Maximum leverage for positions
HYPERLIQUID_POSITION_SIZE_USD=1000  # USD size per position
HYPERLIQUID_SLIPPAGE=0.03  # 3% acceptable slippage
HYPERLIQUID_ORDER_TYPE=market  # market or limit
HYPERLIQUID_MAX_CONCURRENT_POSITIONS=10  # Max open positions at once
HYPERLIQUID_MAX_DAILY_TRADES=100  # Max trades per day
HYPERLIQUID_COIN_SELECTION_WEIGHT=liquidity  # uniform, liquidity, volume, or smart_money (falls back to liquidity if Nansen has no matches)
HYPERLIQUID_EXECUTION_INTERVAL_MINUTES=30  # Check for new trades every N minutes
HYPERLIQUID_MONITORING_INTERVAL_SECONDS=300  # Monitor open positions every N seconds

# Coin Selection Filters
HYPERLIQUID_EXCLUDE_COINS=BTC,ETH,USDT,USDC,BUSD,DAI,USD1,FDUSD,PYUSD,TUSD,USDP,GUSD,USDD,USDE,SUSDE,FRAX,CRVUSD,USDS  # Exclude stable and major coins (also auto-detected by price, see HYPERLIQUID_STABLECOIN_PRICE_BAND_PCT below)
HYPERLIQUID_MIN_VOLUME_USD=10000000  # Minimum 24h volume in USD
HYPERLIQUID_MIN_MARKET_CAP_RANK=1  # Minimum market cap rank
HYPERLIQUID_MAX_MARKET_CAP_RANK=120  # Maximum market cap rank (safer, established coins)

# Autonomous Trading - Daily Loss Circuit Breaker
# Halts new trade entries (existing positions still get monitored/closed normally) once the
# account's live equity (collateral + unrealized P&L, funding included) is down this fraction
# from the day's starting balance. A fraction, not a percent: 0.05 = 5%. Set 0 to disable.
# Re-checked once per trading cycle, and resets at the next calendar day. Restart the bot to
# apply a change.
HYPERLIQUID_MAX_DAILY_LOSS_PCT=0.05

# Autonomous Trading - Take Profit / Stop Loss
# Leveraged ROE percentage (pos.unrealized_pnl_percentage), NOT raw price move - a position
# closes once its ROE crosses this threshold, so the effective price-move distance shrinks
# as leverage increases (e.g. 30% ROE at 10x leverage is only a ~3% price move).
HYPERLIQUID_TAKE_PROFIT_PCT=0.30
HYPERLIQUID_STOP_LOSS_PCT=-0.30

# Autonomous Trading - Correlation-Aware Position Limits
# Caps concurrent positions sharing the same CoinGecko sector/category tag (e.g. "Layer 1
# (L1)", "Meme", "DeFi"), used as a proxy since real historical-correlation data isn't
# available for arbitrary altcoins here - avoids N "different" positions being one bet.
HYPERLIQUID_MAX_POSITIONS_PER_CATEGORY=3

# Autonomous Trading - Coins Per Cycle
# How many random altcoin candidates get pulled and analyzed each trading cycle.
HYPERLIQUID_COINS_PER_CYCLE=5

# Autonomous Trading - Automatic Stablecoin Filter
# A fixed HYPERLIQUID_EXCLUDE_COINS ticker list only catches stablecoins you already know the
# name of - newer/less common ones (USD1, FDUSD, PYUSD, USDe...) slip through by name. Anything
# trading within this fraction of $1 is auto-excluded regardless of ticker.
HYPERLIQUID_STABLECOIN_PRICE_BAND_PCT=0.02

# Autonomous Trading - Smart Money Netflow Coin Selection
# Set HYPERLIQUID_COIN_SELECTION_WEIGHT=smart_money (above) to pick each cycle's candidates by
# Nansen Smart Money net accumulation instead of pure liquidity/volume weighting - falls back to
# liquidity weighting automatically if Nansen errors or has no matches among tradeable coins.
HYPERLIQUID_SMART_MONEY_TIMEFRAME=24h  # Netflow window to rank by: 1h, 24h, 7d, or 30d
HYPERLIQUID_SMART_MONEY_MIN_TRADERS=3  # Min distinct smart money wallets behind the flow (filters out single-whale noise)

# Local dashboard server (python web/server.py)
DASHBOARD_PORT=8765
# How often the dashboard's snapshot refreshes while the Start button is on (and immediately on Start)
DASHBOARD_REFRESH_MINUTES=5
