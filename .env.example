# LLM Configuration - OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
CRYPTOAGENTS_LLM_DEEP_THINK_MODEL=claude-opus
CRYPTOAGENTS_LLM_QUICK_THINK_MODEL=gpt-4o
CRYPTOAGENTS_LLM_BACKUP_MODEL=deepseek-chat

# Data APIs
NANSEN_API_KEY=your_nansen_api_key_here
COINGECKO_API_KEY=your_coingecko_api_key_here  # Optional, free tier available
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here  # Optional backup

# Framework Configuration
CRYPTOAGENTS_OUTPUT_LANGUAGE=en
CRYPTOAGENTS_MAX_DEBATE_ROUNDS=3
CRYPTOAGENTS_MAX_RISK_ROUNDS=2
CRYPTOAGENTS_CHECKPOINT_ENABLED=true
CRYPTOAGENTS_TEMPERATURE=0.7
CRYPTOAGENTS_LLM_MAX_RETRIES=3
CRYPTOAGENTS_MAX_TOKENS=8000

# Trading Configuration
CRYPTOAGENTS_TRADEABLE_CRYPTOS=BTC,ETH,SOL,ARB,OP
CRYPTOAGENTS_INITIAL_PORTFOLIO_VALUE=100000
CRYPTOAGENTS_MAX_POSITION_SIZE=0.1
CRYPTOAGENTS_RISK_PER_TRADE=0.02

# Directories
CRYPTOAGENTS_RESULTS_DIR=./results
CRYPTOAGENTS_CACHE_DIR=./cache
CRYPTOAGENTS_MEMORY_LOG_PATH=./cache/trading_memory.md

# Optional: Debug Mode
CRYPTOAGENTS_DEBUG=false
